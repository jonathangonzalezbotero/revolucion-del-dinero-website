# Copy this file to .env.local for local `vercel dev` testing.
# In production, set these in the Vercel dashboard → Project → Settings → Environment Variables.
# NEVER commit the real values — .env.local is already gitignored.

# Your Resend secret API key (starts with "re_").
RESEND_API_KEY=

# The "from" address for outgoing emails. Must be on a domain verified in Resend,
# e.g. "Revolución del Dinero <notificaciones@tudominio.com>"
RESEND_FROM_EMAIL=

# Where mentorship-request notifications land — your inbox.
MENTOR_NOTIFY_EMAIL=

# Your systeme.io public API key (Settings → Public API key in systeme.io).
# Used server-side only, to push event registrations into your systeme.io CRM.
SYSTEME_API_KEY=
