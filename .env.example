# Copy this file to .env.local for local `vercel dev` testing.
# In production, set these in the Vercel dashboard → Project → Settings → Environment Variables.
# NEVER commit the real values — .env.local is already gitignored.

# Your Resend secret API key (starts with "re_").
RESEND_API_KEY=

# The "from" address for outgoing emails. Must be on a domain verified in Resend,
# e.g. "Revolución del Dinero <notificaciones@tudominio.com>"
RESEND_FROM_EMAIL=

# Where mentorship-request notifications land — your inbox.
MENTOR_NOTIFY_EMAIL=

# Your systeme.io public API key (Settings → Public API key in systeme.io).
# Used server-side only, to push event registrations into your systeme.io CRM.
SYSTEME_API_KEY=

# Stripe secret key (Developers → API keys). Server-side only.
STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook endpoint (Developers → Webhooks → your endpoint
# → "Signing secret"). Required to verify that /api/stripe-webhook requests really came
# from Stripe. When testing locally with the Stripe CLI, use the secret it prints:
#   stripe listen --forward-to localhost:3000/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# Price IDs (Products → your product → pricing) for each Evento ticket tier.
STRIPE_PRICE_GENERAL=
STRIPE_PRICE_VIP=

# Price IDs del Bootcamp Financiero (/bootcamp, sábado 28 de noviembre de 2026).
#
# Los importes de Stripe llevan la comisión de la pasarela encima del precio anunciado —
# el cliente la asume, igual que con las entradas del evento ($10 se cobran $10,50). La
# página lo dice explícitamente debajo de cada botón.
#
# El prefijo REACT_APP_ solo controla qué inyecta CRA en el bundle del navegador; Vercel
# expone la misma variable a las funciones serverless, así que este par de variables
# sirve para las dos partes y no hay que configurar el mismo valor dos veces.
# api/create-bootcamp-checkout.js es la autoridad sobre el precio: el navegador manda
# `tier`, nunca un price ID. Si falta una de estas dos variables, la página muestra un
# error claro en español y no intenta cobrar con ningún fallback.
REACT_APP_STRIPE_PRICE_BOOTCAMP_INDIVIDUAL=   # AUD 255,00 — anunciado $250
REACT_APP_STRIPE_PRICE_BOOTCAMP_PAREJA=       # AUD 408,00 — anunciado $400

# Price IDs del Círculo Presencial (/circulo). Cuatro combinaciones: individual o para
# dos personas, cada una en pago único o en 6 cuotas mensuales.
#
# PAGO ÚNICO: los importes de Stripe llevan la comisión de la pasarela encima del precio
# anunciado ($1.000 → $1.018), igual que el resto de los productos. La página lo dice
# explícitamente debajo de cada botón. Tipo de precio en Stripe: *One-off*.
#
# CUOTAS: llevan un 8% de recargo por financiar el pago ($1.000 → $1.080 en 6 pagos de
# $180). Ese 8% ya cubre la comisión de la pasarela, así que la cuota NO lleva fee encima:
# los importes son exactos. Tipo de precio en Stripe: *Recurring*, mensual.
#
# 🔴 Las cuotas son una suscripción mensual que TIENE que apagarse al sexto cobro. Eso lo
# hace api/stripe-webhook.js fijando `cancel_at` en cuanto la suscripción existe (ver
# api/_lib/planCuotas.js), así que STRIPE_WEBHOOK_SECRET tiene que estar configurado y el
# webhook activo, o la suscripción cobraría un séptimo mes.
#
# ⚠️ NO reutilices los precios que ya existen en la cuenta llamados "Plan de pagos" (AUD
# 145/mes) y "Plan de pagos parejas" (AUD 180/mes): son los de las 7 fundadoras, con otro
# precio y otro tratamiento de impuestos. Crea precios nuevos y limpios, aunque el importe
# de $180 coincida.
REACT_APP_STRIPE_PRICE_CIRCULO_INDIVIDUAL=          # AUD 1.018,00 pago único — anunciado $1.000
REACT_APP_STRIPE_PRICE_CIRCULO_PAREJA=              # AUD 1.527,00 pago único — anunciado $1.500
REACT_APP_STRIPE_PRICE_CIRCULO_INDIVIDUAL_CUOTAS=   # AUD 180,00/mes × 6 — total $1.080
REACT_APP_STRIPE_PRICE_CIRCULO_PAREJA_CUOTAS=       # AUD 270,00/mes × 6 — total $1.620
