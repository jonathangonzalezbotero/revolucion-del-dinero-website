{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/evento", "destination": "/evento/index.html" },
    { "source": "/evento/", "destination": "/evento/index.html" },
    { "source": "/bootcamp", "destination": "/bootcamp/index.html" },
    { "source": "/bootcamp/", "destination": "/bootcamp/index.html" },
    { "source": "/circulo", "destination": "/circulo/index.html" },
    { "source": "/circulo/", "destination": "/circulo/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
